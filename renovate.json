{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "groupName": ".NET MGCB tools",
      "matchManagers": ["nuget", "dotnet-tools"],
      "matchPackageNames": [
        "dotnet-mgcb-editor",
        "dotnet-mgcb-editor-mac",
        "dotnet-mgcb-editor-windows",
        "dotnet-mgcb-editor-linux",
        "dotnet-mgcb"
      ]
    },
    {
      "description": "Block internal JetBrains/Kotlin dev builds",
      "matchPackagePrefixes": ["org.jetbrains.kotlin"],
      "allowedVersions": "!/-(mars|dev|ij|m)\\d*/i"
    }
  ]
}
